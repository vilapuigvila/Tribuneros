rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Written only by the scrapeCx Cloud Function (the Admin SDK bypasses rules).
    match /cx/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Detail-page cache, written only by the cxDetail Cloud Function.
    match /cxRiders/{rider} {
      allow read: if true;
      allow write: if false;
    }
    match /cxRaces/{race} {
      allow read: if true;
      allow write: if false;
    }
    match /cxResults/{results} {
      allow read: if true;
      allow write: if false;
    }
  }
}
