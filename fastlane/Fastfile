default_platform(:ios)

PROJECT = "Tribuneros.xcodeproj"
SCHEME = "Tribuneros"
APP_TARGET = "Tribunerus"
EXTERNAL_GROUP = "External-alfys"
BUNDLE_ID = "com.pskmoons.Tribuneros"
CATALAN_LOCALE = "ca"

platform :ios do
  desc "Run the unit tests (skips the two live-network tests)"
  lane :tests do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      device: ENV.fetch("TEST_DEVICE", "iPhone 17"),
      skip_testing: [
        "TribunerosTests/RequesterCxTests",
        "TribunerosTests/RequesterHomeParsingTests/testGetLatestResultsParsesRealWebsite"
      ]
    )
  end

  desc "Bump the build past App Store Connect's latest, commit it, archive and upload to TestFlight"
  lane :beta do
    ensure_release_ready
    api_key, build = bump_and_archive
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
    UI.success("Uploaded build #{build}; the bump commit is local, push it yourself")
  end

  desc "Like beta, then send it to the External-alfys testers with a What to Test you type first"
  lane :beta_external do
    ensure_release_ready
    whats_new = ask_whats_new
    api_key, build = bump_and_archive
    upload_to_testflight(
      api_key: api_key,
      changelog: whats_new,
      distribute_external: true,
      groups: [EXTERNAL_GROUP],
      notify_external_testers: true
    )
    UI.success("Build #{build} sent to #{EXTERNAL_GROUP} (Beta App Review first if Apple asks); push the bump commit yourself")
  end

  desc "Print the latest build number on App Store Connect"
  lane :latest_build do
    UI.message("App Store Connect: #{latest_testflight_build_number(api_key: asc_api_key, initial_build_number: 0)}")
    UI.message("Project: #{app_build_number}")
  end

  desc "Create the App Store version (or reuse the editable one) and set its What's New: new_version version:1.1 whats_new:\"...\" [whats_new_ca:\"...\"]"
  lane :new_version do |options|
    version = options[:version].to_s.strip
    whats_new = options[:whats_new].to_s.strip
    whats_new_ca = options[:whats_new_ca].to_s.strip
    UI.user_error!("Pass the version: new_version version:1.1 whats_new:\"...\"") if version.empty?
    UI.user_error!("Version \"#{version}\" isn't like 1.1 or 1.1.2") unless version.match?(/\A\d+(\.\d+){1,2}\z/)
    UI.user_error!("Pass the What's New text: whats_new:\"...\"") if whats_new.empty?
    { "whats_new" => whats_new, "whats_new_ca" => whats_new_ca }.each do |key, text|
      UI.user_error!("#{key} is #{text.length} characters; the limit is 4000.") if text.length > 4000
    end

    asc_api_key
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID) || UI.user_error!("No app #{BUNDLE_ID} on App Store Connect")
    texts = { app.primary_locale => whats_new }
    texts[CATALAN_LOCALE] = whats_new_ca unless whats_new_ca.empty?
    app_version = editable_app_version(app, version)
    set_whats_new(app_version, texts, app.primary_locale)
    UI.success("Version #{version} (#{app_version.id}) has What's New for #{texts.keys.join(", ")}; nothing else touched, not submitted")
  end
end

def ensure_release_ready
  ensure_git_branch(branch: "^development$")
  ensure_git_status_clean
end

# Returns [api_key, build]; the build number is committed (not pushed) before archiving.
def bump_and_archive
  api_key = asc_api_key
  build = next_build_number(api_key)
  set_app_build_number(build)
  git_commit(
    path: "#{PROJECT}/project.pbxproj",
    message: "Bump build number to #{build}"
  )
  build_app(
    project: PROJECT,
    scheme: SCHEME,
    configuration: "Release",
    export_method: "app-store",
    output_directory: "build",
    xcargs: auth_xcargs # gym also passes xcargs to -exportArchive, so no export_xcargs (it would duplicate them)
  )
  [api_key, build]
end

# Asked before archiving, so nothing waits on the keyboard later. TestFlight caps What to Test at 4000 characters.
def ask_whats_new
  UI.user_error!("beta_external asks for the What to Test text, so it needs a terminal") unless UI.interactive?
  loop do
    text = prompt(
      text: "What to Test for #{EXTERNAL_GROUP} (several lines; type END on its own line to finish):",
      multi_line_end_keyword: "END"
    ).to_s.strip
    return text if !text.empty? && text.length <= 4000
    UI.error(text.empty? ? "What to Test can't be empty." : "What to Test is #{text.length} characters; the limit is 4000.")
  end
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"))
  )
end

# xcodebuild can't reuse fastlane's API key, so automatic signing gets it explicitly.
def auth_xcargs
  [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath #{File.expand_path(ENV.fetch('ASC_KEY_PATH')).shellescape}",
    "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
    "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
  ].join(" ")
end

# Reuses the prepare-for-submission iOS version when it has this number, else creates it. A different editable number
# fails instead of being renamed (a rename would silently hijack a version someone is preparing); so does this number
# existing in any other state (live, in review...), since it can't be edited or created again.
def editable_app_version(app, version)
  platform = Spaceship::ConnectAPI::Platform::IOS
  states = Spaceship::ConnectAPI::AppStoreVersion::AppVersionState
  versions = app.get_app_store_versions(
    filter: { platform: platform },
    includes: nil
  )
  same = versions.find { |v| v.version_string == version }
  if same
    UI.user_error!("Version #{version} already exists in state #{same.app_version_state}, not editable") unless same.app_version_state == states::PREPARE_FOR_SUBMISSION
    UI.message("Reusing the editable version #{version}")
    return same
  end
  other = versions.find { |v| v.app_version_state == states::PREPARE_FOR_SUBMISSION }
  UI.user_error!("Editable version #{other.version_string} already exists; finish or delete it first (not renaming it to #{version})") if other

  UI.message("Creating version #{version}")
  Spaceship::ConnectAPI.post_app_store_version(
    app_id: app.id,
    attributes: { versionString: version, platform: platform }
  ).to_models.first
end

# Only the primary locale is created when missing; another locale must already be on the version (adding a language
# needs its description and keywords too), and that is checked before any text is written.
def set_whats_new(app_version, texts, primary_locale)
  localizations = app_version.get_app_store_version_localizations
  missing = texts.keys.reject { |locale| locale == primary_locale || localizations.any? { |l| l.locale == locale } }
  UI.user_error!("No #{missing.join(", ")} listing on this version; add the language in App Store Connect first") unless missing.empty?
  texts.each do |locale, text|
    localization = localizations.find { |l| l.locale == locale }
    if localization
      localization.update(attributes: { whatsNew: text })
    else
      app_version.create_app_store_version_localization(attributes: { locale: locale, whatsNew: text })
    end
  end
end

# The repo's number can lag App Store Connect, so take whichever is higher.
def next_build_number(api_key)
  remote = latest_testflight_build_number(api_key: api_key, initial_build_number: 0).to_i
  [remote, app_build_number].max + 1
end

def app_target
  require "xcodeproj"
  project = Xcodeproj::Project.open(File.expand_path("../#{PROJECT}", __dir__))
  project.targets.find { |t| t.name == APP_TARGET } || UI.user_error!("No target #{APP_TARGET}")
end

def app_build_number
  app_target.build_configurations.map { |c| c.build_settings["CURRENT_PROJECT_VERSION"].to_i }.max
end

# Edits the pbxproj text, since Xcodeproj's save rewrites unrelated parts of an objectVersion 77 project.
def set_app_build_number(build)
  path = File.expand_path("../#{PROJECT}/project.pbxproj", __dir__)
  text = File.read(path)
  app_target.build_configurations.each do |config|
    text = text.sub(/(#{config.uuid} \/\*.*?CURRENT_PROJECT_VERSION = )\d+;/m, "\\1#{build};")
  end
  File.write(path, text)
end
