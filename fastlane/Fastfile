default_platform(:ios)

PROJECT = "Tribuneros.xcodeproj"
SCHEME = "Tribuneros"
APP_TARGET = "Tribunerus"
EXTERNAL_GROUP = "External-alfys"
BUNDLE_ID = "com.pskmoons.Tribuneros"
CATALAN_LOCALE = "ca"

platform :ios do
  desc "Run the unit tests (skips the two live-network tests)"
  lane :tests do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      device: ENV.fetch("TEST_DEVICE", "iPhone 17"),
      skip_testing: [
        "TribunerosTests/RequesterCxTests",
        "TribunerosTests/RequesterHomeParsingTests/testGetLatestResultsParsesRealWebsite"
      ]
    )
  end

  desc "Optionally ask a new version (empty skips), bump the build past App Store Connect's latest, commit, archive and upload to TestFlight"
  lane :beta do
    ensure_release_ready
    version = ask_optional_version # asked before archiving, so nothing waits on the keyboard later
    if version
      set_app_version(version)
      git_commit(path: "#{PROJECT}/project.pbxproj", message: "Bump version to #{version}")
    end
    api_key, build = bump_and_archive
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
    UI.success("Uploaded #{version || app_version_number} (#{build}); the bump commits are local, push them yourself")
  end

  desc "Like beta (optional new version, empty skips), then send it to the External-alfys testers with a What to Test you type first"
  lane :beta_external do
    ensure_release_ready
    version = ask_optional_version # asked before archiving, so nothing waits on the keyboard later
    whats_new = ask_whats_new
    if version
      set_app_version(version)
      git_commit(path: "#{PROJECT}/project.pbxproj", message: "Bump version to #{version}")
    end
    api_key, build = bump_and_archive
    upload_to_testflight(
      api_key: api_key,
      changelog: whats_new,
      distribute_external: true,
      groups: [EXTERNAL_GROUP],
      notify_external_testers: true
    )
    UI.success("#{version || app_version_number} (#{build}) sent to #{EXTERNAL_GROUP} (Beta App Review first if Apple asks); the bump commits are local, push them yourself")
  end

  desc "Print the latest build number on App Store Connect"
  lane :latest_build do
    UI.message("App Store Connect: #{latest_testflight_build_number(api_key: asc_api_key, initial_build_number: 0)}")
    UI.message("Project: #{app_build_number}")
  end

  desc "From a clean development branch: ask the new version and its What's New (English, Catalan), archive the .ipa with that version, and upload binary and texts to App Store Connect: new_version version:1.1 whats_new:\"...\" whats_new_ca:\"...\""
  lane :new_version do |options|
    ensure_release_ready # before asking anything: wrong branch or a dirty tree stops here
    version = options[:version].to_s.strip
    whats_new = options[:whats_new].to_s.strip
    whats_new_ca = options[:whats_new_ca].to_s.strip

    # 1-3: everything is asked up front (a value passed as an option skips its question), so nothing waits later
    version = ask_version if version.empty?
    whats_new = ask_text("What's New (English)") if whats_new.empty?
    whats_new_ca = ask_text("What's New (Catalan)") if whats_new_ca.empty?
    UI.user_error!("Version \"#{version}\" isn't like 1.1 or 1.1.2") unless version.match?(/\A\d+(\.\d+){1,2}\z/)
    { "whats_new" => whats_new, "whats_new_ca" => whats_new_ca }.each do |key, text|
      UI.user_error!("#{key} is empty") if text.empty?
      UI.user_error!("#{key} is #{text.length} characters; the limit is 4000.") if text.length > 4000
    end

    # Checked before archiving, so a failure here costs nothing: the version must be creatable or the editable one.
    api_key = asc_api_key
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID) || UI.user_error!("No app #{BUNDLE_ID} on App Store Connect")
    check_version_available(app, version)

    # 4: archive with the new version; the build number is bumped only if the project's isn't already past App Store Connect
    set_app_version(version)
    git_commit(path: "#{PROJECT}/project.pbxproj", message: "Bump version to #{version}")
    _, build, ipa = bump_and_archive(only_if_needed: true)

    # 5: version, texts and binary to App Store Connect (not submitted for review)
    texts = { app.primary_locale => whats_new, CATALAN_LOCALE => whats_new_ca }
    app_version = editable_app_version(app, version)
    set_whats_new(app_version, texts, app.primary_locale)
    upload_to_app_store(
      api_key: api_key,
      ipa: ipa,
      app_version: version,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      run_precheck_before_submit: false
    )
    UI.success("Version #{version} (build #{build}) uploaded with What's New in #{texts.keys.join(", ")}; not submitted, and the bump commits are local: push them yourself")
  end
end

def ensure_release_ready
  ensure_git_branch(branch: "^development$")
  ensure_git_status_clean
end

# Returns [api_key, build, ipa_path]; the build number is committed (not pushed) before archiving. With only_if_needed
# the build is left alone when the project's number is already past App Store Connect's.
def bump_and_archive(only_if_needed: false)
  api_key = asc_api_key
  build = next_build_number(api_key, only_if_needed: only_if_needed)
  if build == app_build_number
    UI.message("Build #{build} is already past App Store Connect; not bumping")
  else
    set_app_build_number(build)
    git_commit(
      path: "#{PROJECT}/project.pbxproj",
      message: "Bump build number to #{build}"
    )
  end
  build_app(
    project: PROJECT,
    scheme: SCHEME,
    configuration: "Release",
    export_method: "app-store",
    output_directory: "build",
    xcargs: auth_xcargs # gym also passes xcargs to -exportArchive, so no export_xcargs (it would duplicate them)
  )
  [api_key, build, lane_context[SharedValues::IPA_OUTPUT_PATH]]
end

# Asked before archiving, so nothing waits on the keyboard later. App Store Connect and TestFlight cap these at 4000.
def ask_text(label)
  UI.user_error!("#{label} is asked on a terminal; pass it as an option instead") unless UI.interactive?
  loop do
    text = prompt(
      text: "#{label} (several lines; type END on its own line to finish):",
      multi_line_end_keyword: "END"
    ).to_s.strip
    return text if !text.empty? && text.length <= 4000
    UI.error(text.empty? ? "#{label} can't be empty." : "#{label} is #{text.length} characters; the limit is 4000.")
  end
end

def ask_whats_new
  ask_text("What to Test for #{EXTERNAL_GROUP}")
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"))
  )
end

# xcodebuild can't reuse fastlane's API key, so automatic signing gets it explicitly.
def auth_xcargs
  [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath #{File.expand_path(ENV.fetch('ASC_KEY_PATH')).shellescape}",
    "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
    "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
  ].join(" ")
end

# The same rules as editable_app_version, without creating anything.
def check_version_available(app, version)
  platform = Spaceship::ConnectAPI::Platform::IOS
  states = Spaceship::ConnectAPI::AppStoreVersion::AppVersionState
  versions = app.get_app_store_versions(filter: { platform: platform }, includes: nil)
  same = versions.find { |v| v.version_string == version }
  UI.user_error!("Version #{version} already exists in state #{same.app_version_state}, not editable") if same && same.app_version_state != states::PREPARE_FOR_SUBMISSION
  other = versions.find { |v| v.app_version_state == states::PREPARE_FOR_SUBMISSION }
  UI.user_error!("Editable version #{other.version_string} already exists; finish or delete it first (not renaming it to #{version})") if other && !same
end

# Reuses the prepare-for-submission iOS version when it has this number, else creates it. A different editable number
# fails instead of being renamed (a rename would silently hijack a version someone is preparing); so does this number
# existing in any other state (live, in review...), since it can't be edited or created again.
def editable_app_version(app, version)
  platform = Spaceship::ConnectAPI::Platform::IOS
  states = Spaceship::ConnectAPI::AppStoreVersion::AppVersionState
  versions = app.get_app_store_versions(
    filter: { platform: platform },
    includes: nil
  )
  same = versions.find { |v| v.version_string == version }
  if same
    UI.user_error!("Version #{version} already exists in state #{same.app_version_state}, not editable") unless same.app_version_state == states::PREPARE_FOR_SUBMISSION
    UI.message("Reusing the editable version #{version}")
    return same
  end
  other = versions.find { |v| v.app_version_state == states::PREPARE_FOR_SUBMISSION }
  UI.user_error!("Editable version #{other.version_string} already exists; finish or delete it first (not renaming it to #{version})") if other

  UI.message("Creating version #{version}")
  Spaceship::ConnectAPI.post_app_store_version(
    app_id: app.id,
    attributes: { versionString: version, platform: platform }
  ).to_models.first
end

# Only the primary locale is created when missing; another locale must already be on the version (adding a language
# needs its description and keywords too), and that is checked before any text is written.
def set_whats_new(app_version, texts, primary_locale)
  localizations = app_version.get_app_store_version_localizations
  missing = texts.keys.reject { |locale| locale == primary_locale || localizations.any? { |l| l.locale == locale } }
  UI.user_error!("No #{missing.join(", ")} listing on this version; add the language in App Store Connect first") unless missing.empty?
  texts.each do |locale, text|
    localization = localizations.find { |l| l.locale == locale }
    if localization
      localization.update(attributes: { whatsNew: text })
    else
      app_version.create_app_store_version_localization(attributes: { locale: locale, whatsNew: text })
    end
  end
end

# The repo's number can lag App Store Connect, so take whichever is higher. only_if_needed keeps the project's own
# number when it is already past App Store Connect's.
def next_build_number(api_key, only_if_needed: false)
  remote = latest_testflight_build_number(api_key: api_key, initial_build_number: 0).to_i
  local = app_build_number
  return local if only_if_needed && local > remote
  [remote, local].max + 1
end

def app_target
  require "xcodeproj"
  project = Xcodeproj::Project.open(File.expand_path("../#{PROJECT}", __dir__))
  project.targets.find { |t| t.name == APP_TARGET } || UI.user_error!("No target #{APP_TARGET}")
end

def app_build_number
  app_target.build_configurations.map { |c| c.build_settings["CURRENT_PROJECT_VERSION"].to_i }.max
end

# Edits the pbxproj text, since Xcodeproj's save rewrites unrelated parts of an objectVersion 77 project.
def set_app_build_number(build)
  path = File.expand_path("../#{PROJECT}/project.pbxproj", __dir__)
  text = File.read(path)
  app_target.build_configurations.each do |config|
    text = text.sub(/(#{config.uuid} \/\*.*?CURRENT_PROJECT_VERSION = )\d+;/m, "\\1#{build};")
  end
  File.write(path, text)
end

def app_version_number
  app_target.build_configurations.map { |c| c.build_settings["MARKETING_VERSION"].to_s }.max
end

# Same text edit as the build number, for MARKETING_VERSION.
def set_app_version(version)
  path = File.expand_path("../#{PROJECT}/project.pbxproj", __dir__)
  text = File.read(path)
  app_target.build_configurations.each do |config|
    text = text.sub(/(#{config.uuid} \/\*.*?MARKETING_VERSION = )[^;]+;/m, "\\1#{version};")
  end
  File.write(path, text)
end
